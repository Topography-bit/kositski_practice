<Window x:Class="WpfOrderCalculator.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа"
        Height="260"
        Width="340"
        WindowStartupLocation="Manual">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Выбранные позиции"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <ListBox x:Name="ItemsListBox"
                 Grid.Row="1" />
    </Grid>
</Window>
