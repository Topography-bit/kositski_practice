<Window x:Class="PrintApp.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предпросмотр печати"
        Height="720"
        Width="900"
        MinHeight="560"
        MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Печать" Padding="8,4" Margin="4,0" Click="PrintButton_Click" />
            <Button Content="Закрыть" Padding="8,4" Margin="4,0" Click="CloseButton_Click" />
        </ToolBar>
        <DocumentViewer x:Name="Viewer" />
    </DockPanel>
</Window>
