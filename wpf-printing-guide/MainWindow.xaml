<Window x:Class="PrintApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTF редактор и печать"
        Height="680"
        Width="980"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Height="48">
            <Button Content="Новый" Padding="8,4" Margin="4,0" Click="NewButton_Click" />
            <Button Content="Открыть RTF" Padding="8,4" Margin="4,0" Click="OpenButton_Click" />
            <Button Content="Сохранить RTF" Padding="8,4" Margin="4,0" Click="SaveButton_Click" />
            <Separator />
            <Button Content="Жирный" Padding="8,4" Margin="4,0" Command="EditingCommands.ToggleBold" />
            <Button Content="Курсив" Padding="8,4" Margin="4,0" Command="EditingCommands.ToggleItalic" />
            <Button Content="Подчеркнуть" Padding="8,4" Margin="4,0" Command="EditingCommands.ToggleUnderline" />
            <Separator />
            <Button Content="Предпросмотр" Padding="8,4" Margin="4,0" Click="PreviewButton_Click" />
            <Button Content="Печать" Padding="8,4" Margin="4,0" Click="PrintButton_Click" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusLabel" Text="Готово" />
        </StatusBar>

        <Border Margin="12"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                Background="#F6F8FA"
                Padding="16">
            <RichTextBox x:Name="Editor"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI"
                         FontSize="14" />
        </Border>
    </DockPanel>
</Window>
