<Window x:Class="MessageChatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат с WebAPI"
        Height="680"
        Width="900"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AuthPanel"
                Padding="18"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                Background="#F6F8FA"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Адрес API" FontWeight="SemiBold" />
                    <TextBox x:Name="ApiUrlTextBox"
                             Text="http://localhost:5247"
                             Height="32"
                             Margin="0,6,0,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Имя пользователя" FontWeight="SemiBold" />
                    <TextBox x:Name="UserNameTextBox"
                             Height="32"
                             Margin="0,6,0,0"
                             VerticalContentAlignment="Center" />
                    <TextBlock x:Name="UserNameLockLabel"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#57606A"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Пароль" FontWeight="SemiBold" />
                    <PasswordBox x:Name="PasswordBox"
                                 Height="32"
                                 Margin="0,6,0,0" />
                </StackPanel>

                <Button Grid.Column="3"
                        Width="110"
                        Height="34"
                        Margin="0,22,8,0"
                        Content="Войти"
                        Click="LoginButton_Click" />
                <Button Grid.Column="4"
                        Width="130"
                        Height="34"
                        Margin="0,22,0,0"
                        Content="Регистрация"
                        Click="RegisterButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <TextBlock x:Name="SessionLabel"
                           DockPanel.Dock="Left"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="Не выполнен вход" />
                <Button DockPanel.Dock="Right"
                        Width="104"
                        Height="32"
                        Content="Обновить"
                        Click="RefreshButton_Click" />
            </DockPanel>

            <Border Grid.Row="1"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="6">
                <ListBox x:Name="MessagesListBox"
                         BorderThickness="0"
                         Background="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="4" Background="#F6F8FA" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding UserName}" />
                                        <Run Text=" #" />
                                        <Run Text="{Binding Id}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding CreatedAtText}" Foreground="#57606A" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageTextBox"
                         Height="40"
                         VerticalContentAlignment="Center"
                         IsEnabled="False" />
                <Button Grid.Column="1"
                        Width="120"
                        Height="40"
                        Margin="10,0,0,0"
                        Content="Отправить"
                        Click="SendButton_Click" />
            </Grid>

            <TextBlock x:Name="StatusLabel"
                       Grid.Row="2"
                       Margin="0,58,0,0"
                       Foreground="#57606A" />
        </Grid>
    </Grid>
</Window>
