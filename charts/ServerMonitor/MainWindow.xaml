<Window x:Class="ServerMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мониторинг сервера"
        Height="640"
        Width="980"
        MinHeight="560"
        MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Padding="16" Margin="0,0,12,0" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="CPU" Foreground="#57606A" />
                    <TextBlock x:Name="CpuLabel" FontSize="28" FontWeight="SemiBold" Text="0%" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="16" Margin="0,0,12,0" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="RAM" Foreground="#57606A" />
                    <TextBlock x:Name="RamLabel" FontSize="28" FontWeight="SemiBold" Text="0%" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" Margin="0,0,12,0" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Uptime" Foreground="#57606A" />
                    <TextBlock x:Name="UptimeLabel" FontSize="28" FontWeight="SemiBold" Text="00:00:00" />
                </StackPanel>
            </Border>

            <Button x:Name="ToggleButton"
                    Grid.Column="3"
                    Width="120"
                    Height="42"
                    Content="Стоп"
                    Click="ToggleButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,9,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Загрузка CPU" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Canvas x:Name="CpuCanvas" Grid.Row="1" Background="White" SizeChanged="ChartCanvas_SizeChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="9,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Использование RAM" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Canvas x:Name="RamCanvas" Grid.Row="1" Background="White" SizeChanged="ChartCanvas_SizeChanged" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
