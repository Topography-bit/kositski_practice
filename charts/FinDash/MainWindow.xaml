<Window x:Class="FinDash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FinDash"
        Height="720"
        Width="1080"
        MinHeight="640"
        MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Актив:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <ComboBox x:Name="AssetComboBox"
                          Width="160"
                          SelectionChanged="AssetComboBox_SelectionChanged" />
            </StackPanel>
            <Button x:Name="ThemeButton"
                    DockPanel.Dock="Right"
                    Width="132"
                    Height="34"
                    Content="Темная тема"
                    Click="ThemeButton_Click" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PriceCard" Padding="16" Margin="0,0,12,0" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Текущая цена" Foreground="#57606A" />
                    <TextBlock x:Name="PriceLabel" FontSize="28" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border x:Name="ChangeCard" Grid.Column="1" Padding="16" Margin="0,0,12,0" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Изменение за день" Foreground="#57606A" />
                    <TextBlock x:Name="ChangeLabel" FontSize="28" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border x:Name="VolumeCard" Grid.Column="2" Padding="16" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Объем сегодня" Foreground="#57606A" />
                    <TextBlock x:Name="VolumeLabel" FontSize="28" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="LinePanel" Grid.RowSpan="2" Padding="14" Margin="0,0,14,0" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Цена за последние 30 дней" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Canvas x:Name="PriceCanvas" Grid.Row="1" SizeChanged="Canvas_SizeChanged" />
                </Grid>
            </Border>

            <Border x:Name="PiePanel" Grid.Column="1" Padding="14" Margin="0,0,0,14" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Распределение портфеля" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Canvas x:Name="PortfolioCanvas" Grid.Row="1" SizeChanged="Canvas_SizeChanged" />
                </Grid>
            </Border>

            <Border x:Name="BarPanel" Grid.Column="1" Grid.Row="1" Padding="14" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Объем торгов по дням" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Canvas x:Name="VolumeCanvas" Grid.Row="1" SizeChanged="Canvas_SizeChanged" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
