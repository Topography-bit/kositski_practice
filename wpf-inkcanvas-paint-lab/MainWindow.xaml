<Window x:Class="WpfPaint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Paint"
        Height="650"
        Width="940"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Height="54">
            <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="4,0" />
            <RadioButton x:Name="DrawRadioButton"
                         Content="Рисовать"
                         IsChecked="True"
                         Tag="Ink"
                         Margin="4,0"
                         Checked="OnModeChanged" />
            <RadioButton Content="Стереть"
                         Tag="EraseByPoint"
                         Margin="4,0"
                         Checked="OnModeChanged" />
            <RadioButton Content="Выделить"
                         Tag="Select"
                         Margin="4,0"
                         Checked="OnModeChanged" />

            <Separator />

            <CheckBox x:Name="HighlighterCheckBox"
                      Content="Маркер"
                      Margin="4,0"
                      VerticalAlignment="Center"
                      Checked="OnHighlighterChanged"
                      Unchecked="OnHighlighterChanged" />

            <Separator />

            <TextBlock Text="Цвет:" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox x:Name="ColorComboBox"
                      Width="120"
                      SelectionChanged="OnColorChanged">
                <ComboBoxItem Tag="Black" IsSelected="True">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Fill="Black" Margin="0,0,6,0" />
                        <TextBlock Text="Черный" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Red">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Fill="Red" Margin="0,0,6,0" />
                        <TextBlock Text="Красный" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Blue">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Fill="Blue" Margin="0,0,6,0" />
                        <TextBlock Text="Синий" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Green">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Fill="Green" Margin="0,0,6,0" />
                        <TextBlock Text="Зеленый" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Orange">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Fill="Orange" Margin="0,0,6,0" />
                        <TextBlock Text="Оранжевый" />
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>

            <Separator />

            <TextBlock Text="Толщина:" VerticalAlignment="Center" Margin="4,0" />
            <Slider x:Name="ThicknessSlider"
                    Minimum="1"
                    Maximum="40"
                    Value="5"
                    Width="120"
                    VerticalAlignment="Center"
                    ValueChanged="OnThicknessChanged" />
            <TextBlock x:Name="ThicknessLabel"
                       Text="5"
                       Width="28"
                       VerticalAlignment="Center" />

            <Separator />

            <Button Content="Открыть"
                    Margin="4,0"
                    Padding="8,4"
                    Click="OnOpenImage" />
            <Button Content="Очистить"
                    Margin="4,0"
                    Padding="8,4"
                    Click="OnClear" />
            <Button Content="Отменить"
                    Margin="4,0"
                    Padding="8,4"
                    Click="OnUndo" />
            <Button Content="Сохранить PNG"
                    Margin="4,0"
                    Padding="8,4"
                    Click="OnSave" />
        </ToolBar>

        <Border BorderBrush="#8C959F"
                BorderThickness="1"
                Margin="10"
                Background="White">
            <InkCanvas x:Name="PaintCanvas" Background="White">
                <Image x:Name="BackgroundImage"
                       Stretch="Uniform"
                       IsHitTestVisible="False"
                       InkCanvas.Left="0"
                       InkCanvas.Top="0" />
            </InkCanvas>
        </Border>
    </DockPanel>
</Window>
